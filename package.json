{
  "name": "dsh-plugin-model-capability",
  "version": "1.2.0",
  "description": "Model Capability Manager for DSH Web: per-model thinking levels, context window, output caps, input modalities, gateway compat, route defaults, one-click presets, EN/中文 UI.",
  "license": "MIT",
  "author": "dsh-plugin-model-capability contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuioi666/dsh-plugin-model-capability.git"
  },
  "homepage": "https://github.com/yuioi666/dsh-plugin-model-capability#readme",
  "bugs": {
    "url": "https://github.com/yuioi666/dsh-plugin-model-capability/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "model-capability",
    "reasoning-efforts",
    "thinking-levels",
    "context-window",
    "max-tokens",
    "gateway-compatibility",
    "settings-ui",
    "llm",
    "llm-pi-ai",
    "one-click-preset"
  ]
}